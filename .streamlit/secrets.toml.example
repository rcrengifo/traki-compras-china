# Copia este archivo como  secrets.toml  y pega tu cadena de conexion de Supabase.
# (secrets.toml esta en .gitignore: NO se sube a GitHub)
#
# En Supabase:  Project Settings -> Database -> Connection string -> URI
# Reemplaza [YOUR-PASSWORD] por la contrasena de tu base.
# Para Streamlit Cloud usa el "Session pooler" o "Transaction pooler".

DATABASE_URL = "postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres"

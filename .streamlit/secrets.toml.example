# Copia este archivo como  secrets.toml  y pega tu cadena de conexion de Supabase.
# (secrets.toml esta en .gitignore: NO se sube a GitHub)
#
# En Supabase:  Connect -> Connection string (Shared/Transaction pooler).
# Reemplaza [YOUR-PASSWORD] por la contrasena de tu base.
#
# IMPORTANTE: usa el puerto 6543 (Transaction pooler) y agrega ?sslmode=require
# El puerto 5432 puede estar bloqueado por algunas redes/ISP.

DATABASE_URL = "postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
